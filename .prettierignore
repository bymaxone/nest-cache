# The lockfile is generated by pnpm and rewritten on every install. Formatting it
# with Prettier strips the blank lines pnpm emits, so the file flips between two
# shapes — one written by `pnpm install`, one by the pre-commit hook — turning
# every dependency change into a whole-file diff.
pnpm-lock.yaml

# Build, coverage and report output is generated, never reviewed.
dist/
coverage/
reports/

# Canonical copies from bymaxone/.github (script-templates/check-function-length), kept byte-identical so
# a family check can compare them; formatting them would make each differ from the template.
scripts/check-function-length.mjs
scripts/function-length-key.mjs
src/check-function-length.spec.ts
src/check-function-length.baseline.spec.ts
src/check-function-length.key.spec.ts
